<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Interface do widget em Avalonia. Hoje é distribuída só para Windows; o suporte ao Linux
    está no roadmap (docs/ROADMAP.md). A lógica fica no SteamWishlistWidget.Core.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      No Windows, o alvo do Windows 10+ libera as notificações nativas (pacote abaixo). Fora dele, o alvo
      comum, sem o pacote. O código só do Windows fica dentro de #if WINDOWS.
    -->
    <TargetFramework Condition="'$(OS)' == 'Windows_NT'">net10.0-windows10.0.19041.0</TargetFramework>
    <TargetFramework Condition="'$(OS)' != 'Windows_NT'">net10.0</TargetFramework>
    <AssemblyName>SteamWishlistWidget</AssemblyName>
    <RootNamespace>SteamWishlistWidget</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Ícone do .exe (também o das notificações) -->
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <!-- Vira a descrição do .exe: é o nome que o Windows mostra nas notificações -->
    <AssemblyTitle>Steam Wishlist Widget</AssemblyTitle>
    <Product>Steam Wishlist Widget</Product>
    <Description>Widget de área de trabalho com a lista de desejos da Steam e suas promoções.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
  </ItemGroup>

  <!-- Notificações nativas do Windows (jogo que entrou em promoção), também para apps fora da Microsoft Store -->
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <!-- O pacote acima puxa o System.Drawing.Common 4.7.0, com falha de segurança conhecida (GHSA-rxg9-xrhp-64gj) -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- JetBrains Mono embutida no executável (licença SIL OFL 1.1) -->
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
    <!-- Ícone das janelas (o do .exe vem do ApplicationIcon) -->
    <AvaloniaResource Include="Assets\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SteamWishlistWidget.Core\SteamWishlistWidget.Core.csproj" />
  </ItemGroup>

</Project>
